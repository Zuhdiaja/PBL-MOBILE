# Copy to .env. Generate distinct secrets: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-random-database-password
WEB_PORT=3000
MAX_UPLOAD_MB=512
# Set true when serving through an HTTPS reverse proxy.
COOKIE_SECURE=false
# OAuth client IDs (Web, Android, iOS) allowed for mobile Google login, comma separated.
# Leave empty to disable Google login; the mobile app then only uses email and password.
GOOGLE_MOBILE_CLIENT_IDS=
# Mobile bearer token lifetime in seconds (default 30 days).
MOBILE_TOKEN_TTL=2592000
# Browser origins allowed to call /api/v1/mobile/auth, comma separated.
# Needed when the Flutter web build is served from another port.
# Example: MOBILE_CORS_ORIGINS=http://localhost:54321
MOBILE_CORS_ORIGINS=
